# Room Scheduling Tracker — copy to .env and fill in your values.
# Never commit a real .env file.

APP_NAME="Room Scheduling Tracker"
# APP_URL is optional. Leave it as the web root, or set it to your XAMPP
# folder URL (e.g. APP_URL=http://localhost/Room-Scheduling-Tracker) to
# force the base path. If unset, the app detects the folder name itself,
# so renaming the folder needs no config change.
APP_URL=http://localhost:8000
APP_DEBUG=false

# MySQL (default — matches database/rst_db.sql)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rst_db
DB_USER=root
DB_PASS=

# SQLite demo alternative (uncomment to use instead of MySQL):
# DB_DRIVER=sqlite
# DB_PATH=storage/rst.db
